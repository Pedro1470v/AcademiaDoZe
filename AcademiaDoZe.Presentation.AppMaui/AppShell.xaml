<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé">

    <!-- DASHBOARD -->
    <FlyoutItem Title="Dashboard">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe871;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardListPage}"
            Route="dashboard" />
    </FlyoutItem>

    <!-- LOGRADOUROS -->
    <FlyoutItem Title="Logradouros">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe7f1;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="logradouros" />
    </FlyoutItem>

    <!-- COLABORADORES -->
    <FlyoutItem Title="Colaboradores">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xea67;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ColaboradorListPage}"
            Route="colaboradores" />
    </FlyoutItem>

    <!-- ALUNOS -->
    <FlyoutItem Title="Alunos">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe80c;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:AlunoListPage}"
            Route="alunos" />
    </FlyoutItem>

    <!-- MATRÍCULAS -->
    <FlyoutItem Title="Matrículas">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xefec;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:MatriculaListPage}"
            Route="matriculas" />
    </FlyoutItem>

    <!-- CONTROLE DE ACESSO -->
    <FlyoutItem Title="Controle de Acesso">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe8f9;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ControleAcessoPage}"
            Route="controleacesso" />
    </FlyoutItem>

    <!-- CONFIGURAÇÕES -->
    <FlyoutItem Title="Configurações">
        <FlyoutItem.Icon>
            <FontImageSource
                FontFamily="MaterialIcons"
                Glyph="&#xe8b8;" />
        </FlyoutItem.Icon>

        <ShellContent
            ContentTemplate="{DataTemplate views:ConfigPage}"
            Route="configuracoes" />
    </FlyoutItem>

</Shell>