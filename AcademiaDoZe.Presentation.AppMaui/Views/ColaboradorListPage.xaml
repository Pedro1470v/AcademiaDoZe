<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
    x:DataType="vm:ColaboradorListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FotoToImageSourceConverter
                x:Key="FotoToImageSourceConverter" />

            <converters:EnumDisplayConverter
                x:Key="EnumDisplay" />

            <DataTemplate
                x:Key="ColaboradorItemTemplate"
                x:DataType="dto:ColaboradorDto">

                <Grid Padding="1" Margin="5">
                    <Border Style="{StaticResource CardBorder}" Margin="10">
                        <Grid
                            Padding="10"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="4">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Nome}"
                                FontAttributes="Bold"
                                FontSize="16" />

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource ButtonSmall}"
                                Clicked="OnEditButtonClicked">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="MaterialIcons"
                                        Glyph="&#xe3c9;" />
                                </Button.ImageSource>
                            </Button>

                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource ButtonDanger}"
                                Clicked="OnDeleteButtonClicked">
                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="MaterialIcons"
                                        Glyph="&#xe872;" />
                                </Button.ImageSource>
                            </Button>

                            <Image
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                Aspect="AspectFill"
                                HeightRequest="120"
                                WidthRequest="120"
                                HorizontalOptions="Start"
                                Margin="0,5,0,10" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding Cpf, StringFormat='CPF: {0}'}" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding Telefone, StringFormat='Telefone: {0}'}" />

                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding Email, StringFormat='E-mail: {0}'}" />

                            <Label
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />

                            <Label
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding DataAdmissao, StringFormat='Admissão: {0:dd/MM/yyyy}'}" />

                            <Label
                                Grid.Row="7"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding Tipo, Converter={StaticResource EnumDisplay}, StringFormat='Cargo: {0}'}" />

                            <Label
                                Grid.Row="8"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}, StringFormat='Vínculo: {0}'}" />

                            <VerticalStackLayout
                                Grid.Row="9"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Spacing="3">

                                <Label
                                    Text="{Binding Endereco.Nome, StringFormat='Logradouro: {0}'}" />

                                <Label
                                    Text="{Binding Numero, StringFormat='Número: {0}'}" />

                                <Label
                                    Text="{Binding Endereco.Bairro, StringFormat='Bairro: {0}'}" />

                                <Label
                                    Text="{Binding Endereco.Cidade, StringFormat='Cidade: {0}'}" />

                                <Label
                                    Text="{Binding Endereco.Estado, StringFormat='Estado: {0}'}" />

                                <Label
                                    Text="{Binding Endereco.Cep, StringFormat='CEP: {0}'}" />

                                <Label
                                    Text="{Binding Complemento, StringFormat='Complemento: {0}'}" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            Style="{StaticResource CardBorder}"
            Margin="15,10">

            <Grid
                ColumnDefinitions="Auto,10,*,10,Auto"
                VerticalOptions="Center">

                <Picker
                    Grid.Column="0"
                    ItemsSource="{Binding FilterTypes}"
                    SelectedItem="{Binding SelectedFilterType}"
                    WidthRequest="110"
                    HeightRequest="40"
                    VerticalOptions="Center" />

                <Entry
                    Grid.Column="2"
                    Text="{Binding SearchText}"
                    Placeholder="Digite o valor..."
                    HeightRequest="40"
                    VerticalOptions="Center"
                    ClearButtonVisibility="WhileEditing"
                    ReturnCommand="{Binding SearchColaboradoresCommand}" />

                <Button
                    Grid.Column="4"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="80"
                    HeightRequest="40"
                    Command="{Binding SearchColaboradoresCommand}">

                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe8b6;" />
                    </Button.ImageSource>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <RefreshView
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefreshCommand}">

                <CollectionView
                    ItemsSource="{Binding Colaboradores}"
                    SelectionMode="None"
                    Margin="10">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=1, Tablet=2, Desktop=3, TV=4, Default=1}" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            VerticalOptions="Center"
                            Padding="20"
                            Spacing="12">

                            <Label
                                Text="Nenhum colaborador encontrado"
                                HorizontalOptions="Center"
                                Style="{StaticResource SubHeadline}" />

                            <Button
                                Text="Adicionar Primeiro Colaborador"
                                Command="{Binding AddColaboradorCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                HeightRequest="50" />

                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorItemTemplate" />
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

            <Button
                Command="{Binding AddColaboradorCommand}"
                Style="{StaticResource ButtonPrimary}"
                WidthRequest="56"
                HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20">

                <Button.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light=Black, Dark=Gray}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
                </Button.Shadow>

                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="MaterialIcons"
                        Glyph="&#xe145;" />
                </Button.ImageSource>

            </Button>

        </Grid>

        <ActivityIndicator
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

    </Grid>

</ContentPage>
