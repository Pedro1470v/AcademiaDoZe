<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
    Title="Alunos">

    <Grid Padding="15"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="15">

        <Label
            Text="Alunos cadastrados"
            FontSize="24"
            FontAttributes="Bold" />

        <Button
            Grid.Row="1"
            Text="+ Novo Aluno"
            Command="{Binding AddAlunoCommand}"
            BackgroundColor="#512BD4"
            TextColor="White"
            HeightRequest="55" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Alunos}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Text="Nenhum aluno cadastrado."
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="12"
                        Margin="0,5"
                        Stroke="#D0D0D0"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Nome}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label Text="{Binding Cpf}" />
                            <Label Text="{Binding Telefone}" />
                            <Label Text="{Binding Email}" />

                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                ColumnSpacing="10"
                                Margin="0,8,0,0">

                                <Button
                                    Grid.Column="1"
                                    Text="Editar"
                                    WidthRequest="100"
                                    BackgroundColor="#512BD4"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.EditAlunoCommand}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Grid.Column="2"
                                    Text="Excluir"
                                    WidthRequest="100"
                                    BackgroundColor="#D32F2F"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.DeleteAlunoCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
