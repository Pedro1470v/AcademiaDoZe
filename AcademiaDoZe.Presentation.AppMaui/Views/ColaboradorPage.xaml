<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorPage"
    x:DataType="vm:ColaboradorViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FotoToImageSourceConverter
                x:Key="FotoToImageSourceConverter" />
            <converters:DateOnlyToDateTimeConverter
                x:Key="DateOnlyConverter" />
            <converters:EnumDisplayConverter
                x:Key="EnumDisplay" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="0,0,0,20">

            <!-- CPF -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="CPF" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry
                            Grid.Column="0"
                            Text="{Binding Colaborador.Cpf}"
                            Placeholder="000.000.000-00"
                            Keyboard="Numeric"
                            MaxLength="14"
                            ClearButtonVisibility="WhileEditing"
                            ReturnCommand="{Binding SearchByCpfCommand}" />
                        <Button
                            Grid.Column="1"
                            Text="Buscar CPF"
                            Command="{Binding SearchByCpfCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            HeightRequest="40"
                            Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Dados pessoais -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <VerticalStackLayout Spacing="15">
                    <Label
                        Text="{Binding Colaborador.Id, StringFormat='Colaborador ID: {0}'}"
                        Style="{StaticResource SubHeadline}"
                        IsVisible="{Binding IsEditMode}" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome" />
                        <Entry
                            Text="{Binding Colaborador.Nome}"
                            Placeholder="Digite o nome completo..."
                            MaxLength="150"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Data de Nascimento" />
                        <DatePicker
                            Date="{Binding Colaborador.DataNascimento, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                            Format="dd/MM/yyyy" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Telefone" />
                        <Entry
                            Text="{Binding Colaborador.Telefone}"
                            Placeholder="(00) 00000-0000"
                            Keyboard="Telephone"
                            MaxLength="15"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email" />
                        <Entry
                            Text="{Binding Colaborador.Email}"
                            Placeholder="exemplo@email.com"
                            Keyboard="Email"
                            MaxLength="100"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Senha" />
                        <Entry
                            Text="{Binding Colaborador.Senha}"
                            Placeholder="Digite a senha..."
                            IsPassword="True"
                            MaxLength="50" />
                        <Label
                            Text="* Deixe em branco para manter a senha atual cadastrada."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            IsVisible="{Binding IsEditMode}"
                            Margin="2,-2,0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Confirmar Senha" />
                        <Entry
                            Text="{Binding ConfirmarSenha}"
                            Placeholder="Confirme a senha..."
                            IsPassword="True"
                            MaxLength="50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Foto" />
                        <Image
                            Source="{Binding Colaborador.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                            Aspect="AspectFill"
                            HeightRequest="120"
                            WidthRequest="120"
                            HorizontalOptions="Start" />
                        <Button
                            Text="Selecionar Imagem"
                            Command="{Binding SelecionarFotoCommand}"
                            Style="{StaticResource ButtonPrimary}">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe226;" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Endereço -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Endereço" Style="{StaticResource SubHeadline}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry
                            Grid.Column="0"
                            Text="{Binding Colaborador.Endereco.Cep}"
                            Placeholder="00000-000"
                            Keyboard="Numeric"
                            MaxLength="9"
                            ClearButtonVisibility="WhileEditing"
                            ReturnCommand="{Binding SearchByCepCommand}" />
                        <Button
                            Grid.Column="1"
                            Text="Buscar CEP"
                            Command="{Binding SearchByCepCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            HeightRequest="40"
                            Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <Border
                        Margin="0,5,0,0"
                        Padding="12"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark=#332701}"
                        IsVisible="{Binding HasNoEnderecoVinculado}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label
                                Grid.Column="0"
                                Text="&#xe002;"
                                FontFamily="MaterialIcons"
                                TextColor="#D97706"
                                VerticalOptions="Center"
                                FontSize="20" />
                            <Label
                                Grid.Column="1"
                                Text="Nenhum logradouro vinculado. Digite o CEP acima e clique em 'Buscar CEP'."
                                TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}"
                                VerticalOptions="Center"
                                FontSize="13"
                                LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,5,0,0"
                        Padding="12"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                        IsVisible="{Binding HasEnderecoVinculado}">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,4">
                                <Label
                                    Text="&#xe876;"
                                    FontFamily="MaterialIcons"
                                    TextColor="#16A34A"
                                    VerticalOptions="Center"
                                    FontSize="18" />
                                <Label
                                    Text="Logradouro Vinculado"
                                    FontAttributes="Bold"
                                    TextColor="#16A34A"
                                    VerticalOptions="Center"
                                    FontSize="14" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Colaborador.Endereco.Nome, StringFormat='Rua: {0}'}" />
                            <Label Text="{Binding Colaborador.Endereco.Bairro, StringFormat='Bairro: {0}'}" />
                            <Label Text="{Binding Colaborador.Endereco.Cidade, StringFormat='Cidade: {0}'}" />
                            <Label Text="{Binding Colaborador.Endereco.Estado, StringFormat='Estado: {0}'}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Número" />
                        <Entry
                            Text="{Binding Colaborador.Numero}"
                            Placeholder="Número"
                            MaxLength="20"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Complemento" />
                        <Entry
                            Text="{Binding Colaborador.Complemento}"
                            Placeholder="Complemento (opcional)"
                            MaxLength="50"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Dados de trabalho -->
            <Border Style="{StaticResource CardBorder}" Margin="15,0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Dados de Trabalho" Style="{StaticResource SubHeadline}" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Data de Admissão" />
                        <DatePicker
                            Date="{Binding Colaborador.DataAdmissao, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                            Format="dd/MM/yyyy" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Tipo" />
                        <Picker
                            ItemsSource="{Binding ColaboradorTipos}"
                            SelectedItem="{Binding Colaborador.Tipo}">
                            <Picker.ItemDisplayBinding>
                                <Binding Converter="{StaticResource EnumDisplay}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Vínculo" />
                        <Picker
                            ItemsSource="{Binding ColaboradorVinculos}"
                            SelectedItem="{Binding Colaborador.Vinculo}">
                            <Picker.ItemDisplayBinding>
                                <Binding Converter="{StaticResource EnumDisplay}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Botões -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="15,0">
                <Button
                    Grid.Column="0"
                    Text="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonSecondary}"
                    HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" />
                    </Button.ImageSource>
                </Button>
                <Button
                    Grid.Column="1"
                    Text="Salvar"
                    Command="{Binding SaveColaboradorCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- Carregamento -->
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
