<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
    x:DataType="vm:LogradouroListViewModel"
    Title="{Binding Title}"
    BackgroundColor="#F4F4F4">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- CABEÇALHO -->
                <Border
                    BackgroundColor="#000000"
                    Padding="20"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">

                    <Border.Shadow>
                        <Shadow
                            Brush="#50000000"
                            Offset="0,5"
                            Radius="12"
                            Opacity="0.35" />
                    </Border.Shadow>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="15">

                        <VerticalStackLayout
                            Spacing="5">

                            <Label
                                Text="LOGRADOUROS"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF" />

                            <Label
                                Text="Gerencie os endereços da Academia do Zé"
                                FontSize="14"
                                TextColor="#CCCCCC" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="55"
                            HeightRequest="55"
                            BackgroundColor="#FFD600"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            VerticalOptions="Center">

                            <Label
                                Text="⌂"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#000000"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                    </Grid>

                </Border>


                <!-- RESUMO -->
                <Border
                    BackgroundColor="#FFD600"
                    Padding="18"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="15">

                        <Border
                            WidthRequest="55"
                            HeightRequest="55"
                            BackgroundColor="#000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">

                            <Label
                                Text="⌖"
                                FontSize="28"
                                TextColor="#FFD600"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="3">

                            <Label
                                Text="ENDEREÇOS CADASTRADOS"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#333333" />

                            <Label
                                Text="{Binding Logradouros.Count, StringFormat='{0} endereço(s) cadastrado(s)'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#000000" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- PESQUISA -->
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="3"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <SearchBar
                        Placeholder="Pesquisar endereço..."
                        Text="{Binding SearchText}"
                        SearchCommand="{Binding SearchLogradourosCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#000000"
                        PlaceholderColor="#888888"
                        CancelButtonColor="#000000" />

                </Border>


                <!-- FILTRO -->
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="12,4"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">

                    <Picker
                        Title="Pesquisar por"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        TextColor="#000000"
                        TitleColor="#777777"
                        BackgroundColor="Transparent" />

                </Border>


                <!-- TÍTULO DA LISTA -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="2,4,2,0">

                    <Label
                        Text="Endereços"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#111111" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding Logradouros.Count, StringFormat='{0} itens'}"
                        FontSize="13"
                        TextColor="#777777"
                        VerticalOptions="Center" />

                </Grid>


                <!-- LISTA DE LOGRADOUROS -->
                <CollectionView
                    ItemsSource="{Binding Logradouros}"
                    SelectionMode="None">

                    <!-- QUANDO NÃO HÁ RESULTADOS -->
                    <CollectionView.EmptyView>

                        <VerticalStackLayout
                            Padding="30"
                            Spacing="10"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label
                                Text="⌂"
                                FontSize="55"
                                TextColor="#CCCCCC"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Nenhum endereço encontrado"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#555555"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Cadastre um novo endereço para começar."
                                FontSize="13"
                                TextColor="#888888"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </CollectionView.EmptyView>


                    <!-- ITEM -->
                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="dto:LogradouroDto">

                            <Border
                                Margin="0,0,0,12"
                                Padding="0"
                                BackgroundColor="#FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#35000000"
                                        Offset="0,3"
                                        Radius="8"
                                        Opacity="0.25" />
                                </Border.Shadow>

                                <Grid
                                    ColumnDefinitions="8,*,Auto"
                                    RowDefinitions="Auto">

                                    <!-- FAIXA AMARELA -->
                                    <BoxView
                                        Grid.Column="0"
                                        Color="#FFD600" />


                                    <!-- INFORMAÇÕES -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Padding="16"
                                        Spacing="6">

                                        <!-- NOME -->
                                        <Label
                                            Text="{Binding Nome}"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="#000000" />

                                        <!-- CEP -->
                                        <Label
                                            Text="{Binding Cep, StringFormat='CEP: {0}'}"
                                            FontSize="14"
                                            TextColor="#555555" />

                                        <!-- BAIRRO -->
                                        <Label
                                            Text="{Binding Bairro, StringFormat='Bairro: {0}'}"
                                            FontSize="14"
                                            TextColor="#555555" />

                                        <!-- CIDADE -->
                                        <Label
                                            Text="{Binding Cidade, StringFormat='Cidade: {0}'}"
                                            FontSize="14"
                                            TextColor="#555555" />

                                        <!-- ESTADO -->
                                        <Label
                                            Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="#333333" />

                                        <!-- PAÍS -->
                                        <Label
                                            Text="{Binding Pais, StringFormat='País: {0}'}"
                                            FontSize="13"
                                            TextColor="#777777" />

                                    </VerticalStackLayout>


                                    <!-- BOTÕES -->
                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        Padding="8"
                                        Spacing="8"
                                        VerticalOptions="Center">

                                        <!-- EDITAR -->
                                        <Border
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="#000000"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13">

                                            <Button
                                                Text="✎"
                                                FontSize="19"
                                                TextColor="#FFD600"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LogradouroListViewModel}}, Path=EditLogradouroCommand}"
                                                CommandParameter="{Binding .}" />

                                        </Border>


                                        <!-- EXCLUIR -->
                                        <Border
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="#EEEEEE"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13">

                                            <Button
                                                Text="✕"
                                                FontSize="17"
                                                TextColor="#C62828"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LogradouroListViewModel}}, Path=DeleteLogradouroCommand}"
                                                CommandParameter="{Binding .}" />

                                        </Border>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <!-- BOTÃO FLUTUANTE ADICIONAR -->
        <Border
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,22,22"
            WidthRequest="65"
            HeightRequest="65"
            BackgroundColor="#FFD600"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 22">

            <Border.Shadow>
                <Shadow
                    Brush="#60000000"
                    Offset="0,5"
                    Radius="10"
                    Opacity="0.45" />
            </Border.Shadow>

            <Button
                Text="+"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="#000000"
                BackgroundColor="Transparent"
                Padding="0"
                Command="{Binding AddLogradouroCommand}" />

        </Border>


        <!-- CARREGANDO -->
        <Grid
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#80000000">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                Color="#FFD600"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>