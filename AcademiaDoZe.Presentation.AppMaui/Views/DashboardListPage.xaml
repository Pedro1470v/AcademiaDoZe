<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#1E1E1E}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Image
                    Source="academiadoze.jpg"
                    HeightRequest="150"
                    WidthRequest="190"
                    Aspect="AspectFit" />

                <Label
                    Text="Academia do Zé"
                    FontSize="32"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                <Label
                    Text="Sistema de Gerenciamento"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#555555, Dark=#D9D9D9}" />

            </VerticalStackLayout>

            <!-- Cards do Dashboard -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="20"
                RowSpacing="20">

                <!-- Logradouros -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                    StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Image
                            Source="{AppThemeBinding Light=logradouros.png, Dark=logradouros_branco.png}"
                            WidthRequest="48"
                            HeightRequest="48"
                            Aspect="AspectFit" />

                        <Label
                            Text="{Binding TotalLogradouros}"
                            FontSize="34"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                        <Label
                            Text="Logradouros"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Alunos -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                    StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Image
                            Source="{AppThemeBinding Light=alunos.png, Dark=alunos_branco.png}"
                            WidthRequest="48"
                            HeightRequest="48"
                            Aspect="AspectFit" />

                        <Label
                            Text="283"
                            FontSize="34"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                        <Label
                            Text="Alunos"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Colaboradores -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                    StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Image
                            Source="{AppThemeBinding Light=colaborador.png, Dark=colaborador_branco.png}"
                            WidthRequest="48"
                            HeightRequest="48"
                            Aspect="AspectFit" />

                        <Label
                            Text="156"
                            FontSize="34"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                        <Label
                            Text="Colaboradores"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                    </VerticalStackLayout>
                </Border>

                <!-- Matrículas -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333333}"
                    StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Image
                            Source="{AppThemeBinding Light=matricula.png, Dark=matricula_branco.png}"
                            WidthRequest="48"
                            HeightRequest="48"
                            Aspect="AspectFit" />

                        <Label
                            Text="93"
                            FontSize="34"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                        <Label
                            Text="Matrículas"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>