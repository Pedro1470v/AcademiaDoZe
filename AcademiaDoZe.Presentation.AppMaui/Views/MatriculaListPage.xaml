<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
    x:Name="MatriculasPage"
    x:DataType="vm:MatriculaListViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>

        <converters:FotoToImageSourceConverter
            x:Key="FotoToImageSourceConverter" />

        <converters:EnumDisplayConverter
            x:Key="EnumDisplay" />

        <converters:RestricoesFlagsDisplayConverter
            x:Key="RestricoesDisplay" />

        <DataTemplate
            x:Key="MatriculaItemTemplate"
            x:DataType="dto:MatriculaDto">

            <Border
                Style="{StaticResource CardBorder}"
                Margin="10"
                Padding="12">

                <Border.Content>
                    <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="4">

                        <!-- FOTO DO ALUNO -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="7"
                            HeightRequest="110"
                            WidthRequest="110"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            VerticalOptions="Center">

                            <Image
                                Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                Aspect="AspectFill"
                                HeightRequest="110"
                                WidthRequest="110" />

                        </Border>

                        <!-- NOME -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{Binding AlunoMatricula.Nome}"
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation" />

                        <!-- CPF E DATA DE NASCIMENTO -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,4"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="CPF: " />
                                    <Span Text="{Binding AlunoMatricula.Cpf}" />
                                    <Span Text=" • Nasc: " />
                                    <Span Text="{Binding AlunoMatricula.DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- PLANO -->
                        <HorizontalStackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Spacing="8"
                            Margin="0,0,0,4">

                            <Border
                                Padding="8,2"
                                StrokeShape="RoundRectangle 4"
                                BackgroundColor="#1976D2">

                                <Label
                                    Text="{Binding Plano, Converter={StaticResource EnumDisplay}}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </Border>

                        </HorizontalStackLayout>

                        <!-- VIGÊNCIA -->
                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,0,3"
                            FontSize="12">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vigência: " FontAttributes="Bold" />
                                    <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Span Text=" até " />
                                    <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- OBJETIVO -->
                        <Label
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,0,3"
                            FontSize="12"
                            LineBreakMode="TailTruncation">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Objetivo: " FontAttributes="Bold" />
                                    <Span Text="{Binding Objetivo}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- RESTRIÇÕES -->
                        <Label
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,0,3"
                            FontSize="12"
                            LineBreakMode="TailTruncation">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Restrições: " FontAttributes="Bold" />
                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- OBSERVAÇÕES -->
                        <Label
                            Grid.Row="6"
                            Grid.Column="0"
                            Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}"
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            LineBreakMode="TailTruncation"
                            Margin="0,0,0,2" />

                        <!-- BOTÕES EDITAR E EXCLUIR -->
                        <HorizontalStackLayout
                            Grid.Row="7"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalOptions="End"
                            Spacing="10"
                            Margin="0,12,0,0">

                            <Button
                                Text="Editar"
                                BackgroundColor="#1976D2"
                                TextColor="White"
                                FontSize="13"
                                HeightRequest="38"
                                CornerRadius="8"
                                Padding="15,0"
                                Command="{Binding BindingContext.EditMatriculaCommand, Source={x:Reference MatriculasPage}}"
                                CommandParameter="{Binding .}" />

                            <Button
                                Text="Excluir"
                                BackgroundColor="#D32F2F"
                                TextColor="White"
                                FontSize="13"
                                HeightRequest="38"
                                CornerRadius="8"
                                Padding="15,0"
                                Command="{Binding BindingContext.DeleteMatriculaCommand, Source={x:Reference MatriculasPage}}"
                                CommandParameter="{Binding .}" />

                        </HorizontalStackLayout>

                    </Grid>
                </Border.Content>

            </Border>

        </DataTemplate>

    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!-- PESQUISA -->
            <Border
                Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="15,10">

                <Border.Content>
                    <Grid
                        ColumnDefinitions="Auto,10,*,10,Auto"
                        VerticalOptions="Center">

                        <Picker
                            Grid.Column="0"
                            ItemsSource="{Binding FilterTypes}"
                            SelectedItem="{Binding SelectedFilterType}"
                            WidthRequest="110"
                            HeightRequest="40"
                            VerticalOptions="Center" />

                        <Entry
                            Grid.Column="2"
                            Text="{Binding SearchText}"
                            Placeholder="Digite o valor..."
                            HeightRequest="40"
                            VerticalOptions="Center"
                            ClearButtonVisibility="WhileEditing"
                            ReturnCommand="{Binding SearchMatriculasCommand}" />

                        <!-- BOTÃO DE PESQUISA -->
                        <Button
                            Grid.Column="4"
                            Text="⌕"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#512BD4"
                            WidthRequest="50"
                            HeightRequest="40"
                            CornerRadius="8"
                            Padding="0"
                            Command="{Binding SearchMatriculasCommand}" />

                    </Grid>
                </Border.Content>

            </Border>

            <!-- LISTA E BOTÃO DE CADASTRO -->
            <Grid Grid.Row="1">

                <RefreshView
                    IsRefreshing="{Binding IsRefreshing}"
                    Command="{Binding RefreshCommand}">

                    <CollectionView
                        ItemsSource="{Binding Matriculas}"
                        ItemTemplate="{StaticResource MatriculaItemTemplate}"
                        SelectionMode="None"
                        Margin="10">

                        <CollectionView.EmptyView>

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                Spacing="15">

                                <Label
                                    Text="Nenhuma matrícula encontrada"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource SubHeadline}" />

                                <Button
                                    Text="Adicionar Primeira Matrícula"
                                    Command="{Binding AddMatriculaCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    HeightRequest="50"
                                    Margin="0,20,0,0" />

                            </VerticalStackLayout>

                        </CollectionView.EmptyView>

                    </CollectionView>

                </RefreshView>

                <!-- BOTÃO FLUTUANTE + -->
                <Button
                    Text="+"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#512BD4"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20"
                    ZIndex="10"
                    Command="{Binding AddMatriculaCommand}">

                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.35" />
                    </Button.Shadow>

                </Button>

            </Grid>

            <!-- CARREGAMENTO -->
            <ActivityIndicator
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </Grid>
    </ContentPage.Content>

</ContentPage>
